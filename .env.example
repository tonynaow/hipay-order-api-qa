# Environnement cible pour l'exécution des tests : mock | stage
TEST_ENV=mock

# Credentials utilisées par le mock server (valeurs par défaut si absentes)
MOCK_API_LOGIN=test-login
MOCK_API_PASSWORD=test-password
MOCK_BASE_URL=http://localhost:3000
MOCK_SERVER_PORT=3000

# Credentials réelles HiPay, requises uniquement si TEST_ENV=stage.
# A fournir via un secret manager / variables CI, jamais en clair dans ce fichier.
HIPAY_API_LOGIN=
HIPAY_API_PASSWORD=
HIPAY_STAGE_BASE_URL=https://cloudrun-api-yugcnet4yq-ew.a.run.app
